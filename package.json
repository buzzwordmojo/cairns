{
  "name": "cairns",
  "version": "0.0.2",
  "description": "A repo-native task board that doubles as memory for coding agents",
  "type": "module",
  "license": "MIT",
  "author": "Bob Mattax <bob@buzzwordmojo.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buzzwordmojo/cairns.git"
  },
  "homepage": "https://github.com/buzzwordmojo/cairns#readme",
  "bugs": {
    "url": "https://github.com/buzzwordmojo/cairns/issues"
  },
  "keywords": [
    "tasks",
    "backlog",
    "project-management",
    "agents",
    "ai",
    "cli",
    "markdown",
    "git"
  ],
  "bin": {
    "cairn": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "bun build src/cli.ts --outdir dist --target node",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
